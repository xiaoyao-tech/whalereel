{
  "name": "WhaleReel",
  "name_zh": "鲸片",
  "version": "0.2.0",
  "description": "一句话生成 30–60 秒代码渲染短片，内置六种风格，支持自动推荐或指定风格。",
  "license": "MIT",
  "install": "bash scripts/install-harness.sh",
  "entry": "SKILL.md",
  "styles": [
